{
  "name": "medcollect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "npm run preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "mailpit": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mailpit.ps1",
    "preview": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state --port 5173 --log-level warn",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "cf:types": "wrangler types --include-runtime=false .tools/cloudflare-bindings.d.ts",
    "mail:dev": "node scripts/mail-capture.mjs",
    "test:workers": "tsx --test --test-concurrency=1 tests/worker-auth.test.ts tests/worker-collections.test.ts tests/covers.test.ts",
    "trace:api": "node services/trace-api/launch.mjs server.py",
    "trace:api:mock": "node services/trace-api/launch.mjs server.py --mock services/trace-api/mock-sample.json",
    "trace:solve": "node services/trace-api/launch.mjs solve.py",
    "trace:test": "node services/trace-api/launch.mjs test_shape.py && node services/trace-api/launch.mjs test_verify.py",
    "setup:local": "node scripts/setup-local.mjs",
    "db:export-legacy": "node scripts/export-legacy.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.11",
    "@libsql/client": "0.18.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "better-auth": "1.7.11",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "nodemailer": "^7.0.13",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.12.0",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "drizzle-kit": "0.31.11",
    "miniflare": "^4.20260730.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wrangler": "^4.151.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module"
}
