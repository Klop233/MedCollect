{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medcollect",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "dist/client", "binding": "ASSETS", "html_handling": "none", "not_found_handling": "none", "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "medcollect", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "drizzle" }],
  "r2_buckets": [{ "binding": "COVERS", "bucket_name": "medcollect-private-covers" }],
  "vars": { "ENVIRONMENT": "production", "MAIL_MODE": "disabled" },
  "observability": { "enabled": false }
}
